{
  "expo": {
    "name": "Raydo-App",
    "slug": "Raydo-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raydoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Raydo uses your location to set pickup point and show nearby rides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Raydo uses your location during active trips for live tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCM7PNM7qrecVBF7VGERs6SLS73kLLZfX8"
        }
      },
      "package": "com.sharma_sunaina.RaydoApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Raydo to use your location for pickup and live trip tracking.",
          "locationAlwaysAndWhenInUsePermission": "Allow Raydo to use your location during active rides.",
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "react-native-maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "081abd09-7e23-4c63-a070-308c42f1d5c8"
      }
    }
  }
}
